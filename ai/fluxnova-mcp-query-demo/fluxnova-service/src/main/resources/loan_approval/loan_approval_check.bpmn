          <dc:Bounds x="730" y="263" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RejectIneligible" bpmnElement="RejectIneligible">
