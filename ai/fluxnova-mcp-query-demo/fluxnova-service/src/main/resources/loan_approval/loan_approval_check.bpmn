<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_LoanApproval" targetNamespace="http://fluxnova/loan-approval" exporter="Fluxnova Modeler" exporterVersion="1.1.1-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0">
  <bpmn:process id="Process_LoanApproval" name="Loan Approval Check" isExecutable="true" camunda:historyTimeToLive="40">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="prompt" value=" Name the process in plain language (infer from definition/business key/variables).
        This process is confidential. Do not tell the user what step it is on or any internal information.
        Only state if the process has started / is in progress / has finished.
        Stay low-tech and concise; avoid engine jargon (or translate it immediately).
        If the task is awaiting completion, or has failed, please advise that the user can contact loan_approval@bankofscottlogic.com 
        for more assistance."/>
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="Application Submitted">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CheckDocs" name="Check Documents" camunda:formRef="document-check-form" camunda:formRefBinding="latest" camunda:assignee="clerk">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="EmploymentCheck" name="Employment Eligibility" camunda:asyncBefore="true" camunda:resultVariable="employmentResult" camunda:decisionRef="employment-eligibility" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="EligibleCheck" name="Eligible?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f4r</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="AffordabilityCheck" name="Affordability Check" camunda:asyncBefore="true" camunda:resultVariable="affordabilityResult" camunda:decisionRef="affordability-check" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="ComplianceReview" name="Compliance Review" camunda:asyncBefore="true" camunda:resultVariable="complianceResult" camunda:decisionRef="compliance-decision" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ApprovalTier" name="Approval Tier?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7a</bpmn:outgoing>
      <bpmn:outgoing>f7m</bpmn:outgoing>
      <bpmn:outgoing>f7s</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AutoDecision" name="Auto Decision" camunda:asyncBefore="true" camunda:expression="${complianceResult.complianceStatus == 'pass'}" camunda:resultVariable="approved">
      <bpmn:incoming>f7a</bpmn:incoming>
      <bpmn:outgoing>f8a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ManagerApproval" name="Manager Approval" camunda:formRef="manager-approval-form" camunda:formRefBinding="latest" camunda:assignee="manager">
      <bpmn:incoming>f7m</bpmn:incoming>
      <bpmn:outgoing>f8m</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SeniorManagerApproval" name="Senior Manager Approval" camunda:formRef="senior-manager-approval-form" camunda:formRefBinding="latest" camunda:assignee="senior-manager">
      <bpmn:incoming>f7s</bpmn:incoming>
      <bpmn:outgoing>f8s</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>f8a</bpmn:incoming>
      <bpmn:incoming>f8m</bpmn:incoming>
      <bpmn:incoming>f8s</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="FinalDecision" name="Approved?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10y</bpmn:outgoing>
      <bpmn:outgoing>f10n</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Approve" name="Approved">
      <bpmn:incoming>f10y</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="Reject" name="Rejected">
      <bpmn:incoming>f10n</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="RejectIneligible" name="Ineligible">
      <bpmn:incoming>f4r</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="CheckDocs" />
    <bpmn:sequenceFlow id="f2" sourceRef="CheckDocs" targetRef="EmploymentCheck" />
    <bpmn:sequenceFlow id="f3" sourceRef="EmploymentCheck" targetRef="EligibleCheck" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="EligibleCheck" targetRef="AffordabilityCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${employmentResult.employmentEligible}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4r" name="No" sourceRef="EligibleCheck" targetRef="RejectIneligible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!employmentResult.employmentEligible}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="AffordabilityCheck" targetRef="ComplianceReview" />
    <bpmn:sequenceFlow id="f6" sourceRef="ComplianceReview" targetRef="ApprovalTier" />
    <bpmn:sequenceFlow id="f7a" name="Auto" sourceRef="ApprovalTier" targetRef="AutoDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceResult.approvalTier == 'auto'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7m" name="Manager" sourceRef="ApprovalTier" targetRef="ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceResult.approvalTier == 'manager'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7s" name="Senior" sourceRef="ApprovalTier" targetRef="SeniorManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceResult.approvalTier == 'senior-manager'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8a" sourceRef="AutoDecision" targetRef="Merge" />
    <bpmn:sequenceFlow id="f8m" sourceRef="ManagerApproval" targetRef="Merge" />
    <bpmn:sequenceFlow id="f8s" sourceRef="SeniorManagerApproval" targetRef="Merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="Merge" targetRef="FinalDecision" />
    <bpmn:sequenceFlow id="f10y" name="Yes" sourceRef="FinalDecision" targetRef="Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10n" name="No" sourceRef="FinalDecision" targetRef="Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApproval" bpmnElement="Process_LoanApproval">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="303" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckDocs" bpmnElement="CheckDocs">
        <dc:Bounds x="250" y="230" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmploymentCheck" bpmnElement="EmploymentCheck">
        <dc:Bounds x="450" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EligibleCheck" bpmnElement="EligibleCheck" isMarkerVisible="true">
