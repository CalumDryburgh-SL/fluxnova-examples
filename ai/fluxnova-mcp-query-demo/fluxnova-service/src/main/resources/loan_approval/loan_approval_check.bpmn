          <dc:Bounds x="670" y="434" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AffordabilityCheck" bpmnElement="AffordabilityCheck">
        <dc:Bounds x="780" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ComplianceReview" bpmnElement="ComplianceReview">
        <dc:Bounds x="1000" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApprovalTier" bpmnElement="ApprovalTier" isMarkerVisible="true">
        <dc:Bounds x="1220" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1207" y="305" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AutoDecision" bpmnElement="AutoDecision">
        <dc:Bounds x="1340" y="370" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManagerApproval" bpmnElement="ManagerApproval">
        <dc:Bounds x="1340" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SeniorManagerApproval" bpmnElement="SeniorManagerApproval">
        <dc:Bounds x="1340" y="80" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge" bpmnElement="Merge" isMarkerVisible="true">
        <dc:Bounds x="1580" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_FinalDecision" bpmnElement="FinalDecision" isMarkerVisible="true">
        <dc:Bounds x="1700" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1763" y="263" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Approve" bpmnElement="Approve">
        <dc:Bounds x="1830" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1821" y="153" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Reject">
        <dc:Bounds x="1830" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1821" y="376" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1">
        <di:waypoint x="188" y="270" />
