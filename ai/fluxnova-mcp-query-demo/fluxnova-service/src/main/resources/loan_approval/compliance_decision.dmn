<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_ComplianceDecision" name="Compliance Decision" namespace="http://fluxnova/loan-approval/dmn" exporter="Fluxnova Modeler" exporterVersion="1.1.0-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0">
  <decision id="compliance-decision" name="Compliance Review" camunda:historyTimeToLive="40">
    <decisionTable id="DecisionTable_Compliance" hitPolicy="FIRST">
      <input id="Input_CreditScore" label="Credit Score" camunda:inputVariable="creditScore">
        <inputExpression id="InputExpression_CreditScore" typeRef="integer">
          <text>creditScore</text>
        </inputExpression>
      </input>
      <input id="Input_LoanAmount" label="Loan Amount" camunda:inputVariable="loanAmount">
        <inputExpression id="InputExpression_LoanAmount" typeRef="double">
          <text>loanAmount</text>
        </inputExpression>
      </input>
      <input id="Input_EmpRiskLevel" label="Employment Risk">
        <inputExpression id="InputExpression_EmpRiskLevel" typeRef="string">
          <text>employmentResult.employmentRiskLevel</text>
        </inputExpression>
      </input>
      <input id="Input_AffRating" label="Affordability Rating">
        <inputExpression id="InputExpression_AffRating" typeRef="string">
          <text>affordabilityResult.affordabilityRating</text>
        </inputExpression>
      </input>
      <output id="Output_ComplianceStatus" label="Compliance Status" name="complianceStatus" typeRef="string" />
      <output id="Output_ApprovalTier" label="Approval Tier" name="approvalTier" typeRef="string" />
      <rule id="Rule_1">
        <description>Very low credit — automatic reject</description>
        <inputEntry id="UT_1a"><text>&lt; 300</text></inputEntry>
        <inputEntry id="UT_1b"><text></text></inputEntry>
        <inputEntry id="UT_1c"><text></text></inputEntry>
        <inputEntry id="UT_1d"><text></text></inputEntry>
        <outputEntry id="LE_1a"><text>"reject"</text></outputEntry>
        <outputEntry id="LE_1b"><text>"auto"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <description>Poor affordability — automatic reject</description>
        <inputEntry id="UT_2a"><text></text></inputEntry>
        <inputEntry id="UT_2b"><text></text></inputEntry>
        <inputEntry id="UT_2c"><text></text></inputEntry>
        <inputEntry id="UT_2d"><text>"poor"</text></inputEntry>
        <outputEntry id="LE_2a"><text>"reject"</text></outputEntry>
        <outputEntry id="LE_2b"><text>"auto"</text></outputEntry>
      </rule>
      <rule id="Rule_3">
        <description>Borderline credit + large loan — senior manager</description>
        <inputEntry id="UT_3a"><text>[300..500)</text></inputEntry>
        <inputEntry id="UT_3b"><text>&gt; 500000</text></inputEntry>
        <inputEntry id="UT_3c"><text></text></inputEntry>
        <inputEntry id="UT_3d"><text></text></inputEntry>
        <outputEntry id="LE_3a"><text>"review"</text></outputEntry>
        <outputEntry id="LE_3b"><text>"senior-manager"</text></outputEntry>
      </rule>
      <rule id="Rule_4">
        <description>Borderline credit + medium employment risk — senior manager</description>
        <inputEntry id="UT_4a"><text>[300..500)</text></inputEntry>
        <inputEntry id="UT_4b"><text></text></inputEntry>
        <inputEntry id="UT_4c"><text>"medium"</text></inputEntry>
        <inputEntry id="UT_4d"><text></text></inputEntry>
        <outputEntry id="LE_4a"><text>"review"</text></outputEntry>
        <outputEntry id="LE_4b"><text>"senior-manager"</text></outputEntry>
      </rule>
      <rule id="Rule_5">
        <description>Borderline credit — manager review</description>
        <inputEntry id="UT_5a"><text>[300..500)</text></inputEntry>
        <inputEntry id="UT_5b"><text></text></inputEntry>
        <inputEntry id="UT_5c"><text></text></inputEntry>
        <inputEntry id="UT_5d"><text></text></inputEntry>
        <outputEntry id="LE_5a"><text>"review"</text></outputEntry>
        <outputEntry id="LE_5b"><text>"manager"</text></outputEntry>
      </rule>
      <rule id="Rule_6">
        <description>Good credit + large loan — manager review</description>
        <inputEntry id="UT_6a"><text>&gt;= 500</text></inputEntry>
        <inputEntry id="UT_6b"><text>&gt; 500000</text></inputEntry>
        <inputEntry id="UT_6c"><text></text></inputEntry>
        <inputEntry id="UT_6d"><text></text></inputEntry>
        <outputEntry id="LE_6a"><text>"review"</text></outputEntry>
        <outputEntry id="LE_6b"><text>"manager"</text></outputEntry>
      </rule>
      <rule id="Rule_7">
        <description>Good credit + medium risk + marginal affordability — manager review</description>
        <inputEntry id="UT_7a"><text>&gt;= 500</text></inputEntry>
        <inputEntry id="UT_7b"><text></text></inputEntry>
        <inputEntry id="UT_7c"><text>"medium"</text></inputEntry>
        <inputEntry id="UT_7d"><text>"marginal"</text></inputEntry>
        <outputEntry id="LE_7a"><text>"review"</text></outputEntry>
        <outputEntry id="LE_7b"><text>"manager"</text></outputEntry>
      </rule>
      <rule id="Rule_8">
        <description>Good credit — auto-approve</description>
        <inputEntry id="UT_8a"><text>&gt;= 500</text></inputEntry>
        <inputEntry id="UT_8b"><text></text></inputEntry>
        <inputEntry id="UT_8c"><text></text></inputEntry>
        <inputEntry id="UT_8d"><text></text></inputEntry>
        <outputEntry id="LE_8a"><text>"pass"</text></outputEntry>
        <outputEntry id="LE_8b"><text>"auto"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="compliance-decision">
        <dc:Bounds height="80" width="180" x="160" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
