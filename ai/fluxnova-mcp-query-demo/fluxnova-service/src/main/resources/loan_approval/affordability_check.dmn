<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_AffordabilityCheck" name="Affordability Check" namespace="http://fluxnova/loan-approval/dmn" exporter="Fluxnova Modeler" exporterVersion="1.1.1-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0">
  <decision id="affordability-check" name="Affordability Check" camunda:historyTimeToLive="40">
    <decisionTable id="DecisionTable_Affordability" hitPolicy="FIRST">
      <input id="Input_LoanToIncome" label="Loan-to-Income Ratio">
        <inputExpression id="InputExpression_LoanToIncome" typeRef="double">
          <text>loanAmount / annualIncome</text>
        </inputExpression>
      </input>
      <input id="Input_DebtBurden" label="Debt Burden Ratio">
        <inputExpression id="InputExpression_DebtBurden" typeRef="double">
          <text>existingMonthlyDebt * 12 / annualIncome</text>
        </inputExpression>
      </input>
      <output id="Output_Affordable" label="Affordable" name="affordable" typeRef="boolean" />
      <output id="Output_Rating" label="Affordability Rating" name="affordabilityRating" typeRef="string" />
      <rule id="AffRule_1">
        <description>Existing debt exceeds 50% of income — unaffordable</description>
        <inputEntry id="AffUT_1a">
          <text></text>
        </inputEntry>
        <inputEntry id="AffUT_1b">
          <text>&gt; 0.5</text>
        </inputEntry>
        <outputEntry id="AffLE_1a">
          <text>false</text>
        </outputEntry>
        <outputEntry id="AffLE_1b">
          <text>"poor"</text>
        </outputEntry>
      </rule>
      <rule id="AffRule_2">
        <description>Loan exceeds 5x annual income — unaffordable</description>
        <inputEntry id="AffUT_2a">
          <text>&gt; 5</text>
        </inputEntry>
        <inputEntry id="AffUT_2b">
          <text></text>
        </inputEntry>
        <outputEntry id="AffLE_2a">
          <text>false</text>
        </outputEntry>
        <outputEntry id="AffLE_2b">
          <text>"poor"</text>
        </outputEntry>
      </rule>
      <rule id="AffRule_3">
        <description>Loan is 3-5x income — marginal</description>
        <inputEntry id="AffUT_3a">
          <text>(3..5]</text>
        </inputEntry>
        <inputEntry id="AffUT_3b">
          <text></text>
        </inputEntry>
        <outputEntry id="AffLE_3a">
          <text>true</text>
        </outputEntry>
        <outputEntry id="AffLE_3b">
          <text>"marginal"</text>
        </outputEntry>
      </rule>
      <rule id="AffRule_4">
        <description>Loan within 3x income — good</description>
        <inputEntry id="AffUT_4a">
          <text>&lt;= 3</text>
        </inputEntry>
        <inputEntry id="AffUT_4b">
          <text></text>
        </inputEntry>
        <outputEntry id="AffLE_4a">
          <text>true</text>
        </outputEntry>
        <outputEntry id="AffLE_4b">
          <text>"good"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="affordability-check">
        <dc:Bounds height="80" width="180" x="160" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>