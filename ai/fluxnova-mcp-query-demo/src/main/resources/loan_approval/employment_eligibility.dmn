<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_EmploymentEligibility" name="Employment Eligibility" namespace="http://fluxnova/loan-approval/dmn" exporter="Fluxnova Modeler" exporterVersion="1.1.1-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0">
  <decision id="employment-eligibility" name="Employment Eligibility Check" camunda:historyTimeToLive="40">
    <decisionTable id="DecisionTable_Employment" hitPolicy="FIRST">
      <input id="Input_EmpStatus" label="Employment Status" camunda:inputVariable="employmentStatus">
        <inputExpression id="InputExpression_EmpStatus" typeRef="string">
          <text>employmentStatus</text>
        </inputExpression>
      </input>
      <input id="Input_LoanPurpose" label="Loan Purpose" camunda:inputVariable="loanPurpose">
        <inputExpression id="InputExpression_LoanPurpose" typeRef="string">
          <text>loanPurpose</text>
        </inputExpression>
      </input>
      <output id="Output_Eligible" label="Eligible" name="employmentEligible" typeRef="boolean" />
      <output id="Output_RiskLevel" label="Risk Level" name="employmentRiskLevel" typeRef="string" />
      <rule id="EmpRule_1">
        <description>Unemployed applicants are ineligible</description>
        <inputEntry id="EmpUT_1a">
          <text>"Unemployed"</text>
        </inputEntry>
        <inputEntry id="EmpUT_1b">
          <text></text>
        </inputEntry>
        <outputEntry id="EmpLE_1a">
          <text>false</text>
        </outputEntry>
        <outputEntry id="EmpLE_1b">
          <text>"high"</text>
        </outputEntry>
      </rule>
      <rule id="EmpRule_2">
        <description>Self-employed seeking mortgage — high risk</description>
        <inputEntry id="EmpUT_2a">
          <text>"Self-Employed"</text>
        </inputEntry>
        <inputEntry id="EmpUT_2b">
          <text>"Mortgage"</text>
        </inputEntry>
        <outputEntry id="EmpLE_2a">
          <text>true</text>
        </outputEntry>
        <outputEntry id="EmpLE_2b">
          <text>"high"</text>
        </outputEntry>
      </rule>
      <rule id="EmpRule_3">
        <description>Self-employed other loans — medium risk</description>
        <inputEntry id="EmpUT_3a">
          <text>"Self-Employed"</text>
        </inputEntry>
        <inputEntry id="EmpUT_3b">
          <text></text>
        </inputEntry>
        <outputEntry id="EmpLE_3a">
          <text>true</text>
        </outputEntry>
        <outputEntry id="EmpLE_3b">
          <text>"medium"</text>
        </outputEntry>
      </rule>
      <rule id="EmpRule_4">
        <description>Employed — low risk</description>
        <inputEntry id="EmpUT_4a">
          <text>"Employed"</text>
        </inputEntry>
        <inputEntry id="EmpUT_4b">
          <text></text>
        </inputEntry>
        <outputEntry id="EmpLE_4a">
          <text>true</text>
        </outputEntry>
        <outputEntry id="EmpLE_4b">
          <text>"low"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="employment-eligibility">
        <dc:Bounds height="80" width="180" x="160" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>